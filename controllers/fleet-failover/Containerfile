FROM docker.io/library/golang:1.25.12-bookworm@sha256:ea341baa9bd5ba6784f6d7161ace70544349a6242d54d34a0fbfd2c4d51c9d58 AS build
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY fleet-edge/ fleet-edge/
COPY fleet-failover/go.mod fleet-failover/
WORKDIR /src/fleet-failover
RUN go mod download 2>/dev/null || true
COPY fleet-failover/ ./
RUN go mod tidy && CGO_ENABLED=0 go build -o /fleet-failover-controller ./cmd/controller

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.source="https://github.com/rborso/umkim"
LABEL org.opencontainers.image.vendor="Robert Borso"
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates=20230311+deb12u1 \
    && rm -rf /var/lib/apt/lists/*
COPY LICENSE NOTICE /licenses/
COPY --from=build /fleet-failover-controller /usr/local/bin/fleet-failover-controller
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/fleet-failover-controller"]
