# DCM Fleet Console — PatternFly SPA + nginx (auth-aware API proxy).
FROM docker.io/library/node:20-alpine AS build
WORKDIR /app
ARG VITE_BUILD_ID=dev
ENV VITE_BUILD_ID=$VITE_BUILD_ID
COPY package.json package-lock.json* ./
RUN npm ci 2>/dev/null || npm install
COPY . .
RUN npm run build

FROM docker.io/library/nginx:1.27-alpine
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.source="https://github.com/rborso/umkim"
LABEL org.opencontainers.image.vendor="Robert Borso"
RUN apk add --no-cache gettext
COPY LICENSE NOTICE /licenses/
COPY --from=build /app/dist /usr/share/nginx/html/fleet
COPY nginx-default.conf.template /etc/nginx/templates/default.conf.template
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
EXPOSE 8080
ENTRYPOINT ["/docker-entrypoint.sh"]
