#!/bin/sh
# SNAT for WAN → spoke Traefik NodePorts.
# Without this, the spoke may reply via the wrong path and external clients never see responses.
# Managed by Ansible: roles/openwrt_edge

SPOKE="{{ hostvars[openwrt_spoke_inventory_host].host_prepare_homelab_ip | default('172.16.10.2') }}"
LAN_NET="{{ openwrt_homelab_subnet | default('172.16.10.0/24') }}"
ROUTER_LAN="{{ openwrt_lan_ip | default('172.16.10.1') }}"
HTTP_PORT="{{ hostvars[openwrt_spoke_inventory_host].spoke_ingress_http_nodeport | default(30080) }}"
HTTPS_PORT="{{ hostvars[openwrt_spoke_inventory_host].spoke_ingress_https_nodeport | default(30443) }}"

_add_snat() {
  port="$1"
  comment="$2"
  if nft list chain inet fw4 srcnat_lan 2>/dev/null | grep -q "$comment"; then
    return 0
  fi
  nft add rule inet fw4 srcnat_lan \
    meta nfproto ipv4 ip daddr "$SPOKE" tcp dport "$port" \
    ip saddr != "$LAN_NET" snat ip to "$ROUTER_LAN" comment "$comment"
}

_add_snat "$HTTP_PORT" "fleet-spoke-snat-http"
_add_snat "$HTTPS_PORT" "fleet-spoke-snat-https"
