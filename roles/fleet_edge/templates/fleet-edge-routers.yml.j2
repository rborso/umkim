# Fleet edge — global active-active routes (Ansible: roles/fleet_edge)
{% for app in fleet_edge_apps %}
{% set app_id = app.name | regex_replace('[^a-zA-Z0-9]+', '-') %}
{% set ns = namespace(has_backends=false, cluster_count=0) %}
{% for cluster in app.clusters | default([]) %}
{% if cluster in fleet_edge_clusters %}
{% set ns.has_backends = true %}
{% set ns.cluster_count = ns.cluster_count + 1 %}
{% endif %}
{% endfor %}
{% set hub_auth = (fleet_ingress_auth_enabled | default(false) | bool) and (ns.cluster_count == 1) %}
{% if ns.has_backends %}
{% if fleet_edge_acme_enabled | default(false) | bool %}
    fleet-{{ app_id }}:
      rule: "Host(`{{ app.host }}`){% if app.path_prefix | default('/') != '/' %} && PathPrefix(`{{ app.path_prefix }}`){% endif %}"
      service: fleet-{{ app_id }}
      entryPoints: [web]
      middlewares: [{% if hub_auth %}fleet-edge-redirect-https{% else %}fleet-edge-forward-headers{% endif %}]
    fleet-{{ app_id }}-tls:
      rule: "Host(`{{ app.host }}`){% if app.path_prefix | default('/') != '/' %} && PathPrefix(`{{ app.path_prefix }}`){% endif %}"
      service: fleet-{{ app_id }}
      entryPoints: [websecure]
      middlewares: [fleet-edge-forward-headers-https{% if hub_auth %}, fleet-edge-authelia{% endif %}]
      tls:
        certResolver: letsencrypt
{% else %}
    fleet-{{ app_id }}:
      rule: "Host(`{{ app.host }}`){% if app.path_prefix | default('/') != '/' %} && PathPrefix(`{{ app.path_prefix }}`){% endif %}"
      service: fleet-{{ app_id }}
      entryPoints: [web]
      middlewares: [fleet-edge-forward-headers{% if hub_auth %}, fleet-edge-authelia{% endif %}]
{% endif %}
{% endif %}
{% endfor %}
