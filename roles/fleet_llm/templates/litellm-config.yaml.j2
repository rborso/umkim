general_settings:
  redis_host: {{ fleet_llm_redis_host | quote }}
  redis_port: {{ fleet_llm_redis_port | quote }}

model_list:
{% if fleet_llm_backends | default([]) | length > 0 %}
{% for b in fleet_llm_backends %}
  - model_name: {{ b.model | default('llama-cpp') }}
    litellm_params:
      model: openai/{{ b.model | default('llama-cpp') }}
      api_base: {{ b.api_base }}
      api_key: "none"
{% endfor %}
{% else %}
  - model_name: llama-cpp-demo
    litellm_params:
      model: openai/Qwen2.5-0.5B-Instruct
      api_base: http://127.0.0.1:8080/v1
      api_key: "none"
{% endif %}

litellm_settings:
  drop_params: true
  set_verbose: false

# Multiple model_list rows with the same model_name are load-balanced by LiteLLM.
# session_affinity pins a conversation when clients send x-litellm-session-id or metadata.session_id.
router_settings:
  routing_strategy: simple-shuffle
  redis_host: {{ fleet_llm_redis_host | quote }}
  redis_port: {{ fleet_llm_redis_port | quote }}
{% if fleet_llm_session_affinity | default(true) | bool %}
  optional_pre_call_checks:
    - session_affinity
  deployment_affinity_ttl_seconds: {{ fleet_llm_session_affinity_ttl_seconds | default(fleet_llm_deployment_affinity_ttl_seconds | default(3600)) }}
{% endif %}
