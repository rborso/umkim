{% set spoke_ingress_method = fleet_site_spoke_ingress_method | default('') %}
{% set phase6_spoke_acme = fleet_edge_acme_enabled | default(false) | bool and fleet_edge_direct_ingress | default(false) | bool and spoke_ingress_method == 'port_forward' %}
{% set phase6_spoke_acme_http_challenge = phase6_spoke_acme_http_challenge | default(false) | bool %}
{% set phase6_traefik_file_provider = fleet_ingress_auth_enabled | default(false) | bool %}
apiVersion: work.open-cluster-management.io/v1
kind: ManifestWork
metadata:
  name: {{ phase6_manifestwork_name }}
  namespace: {{ ocm_target_cluster }}
  labels:
    fleet.umkim.com/phase: "6"
    fleet.umkim.com/role: "spoke"
spec:
{% if phase6_spoke_acme %}
  manifestConfigs:
    - resourceIdentifier:
        group: ""
        resource: persistentvolumeclaims
        name: traefik-acme
        namespace: {{ phase6_spoke_ingress_namespace }}
      updateStrategy:
        type: CreateOnly
{% endif %}
  workload:
    manifests:
      - apiVersion: v1
        kind: Namespace
        metadata:
          name: {{ phase6_spoke_ingress_namespace }}
{% if phase6_spoke_acme %}
      - apiVersion: v1
        kind: PersistentVolumeClaim
        metadata:
          name: traefik-acme
          namespace: {{ phase6_spoke_ingress_namespace }}
        spec:
          accessModes: ["ReadWriteOnce"]
          storageClassName: {{ phase6_traefik_acme_storage_class | default('local-path') }}
          resources:
            requests:
              storage: {{ phase6_traefik_acme_pvc_size | default('1Mi') }}
{% endif %}
      - apiVersion: v1
        kind: ServiceAccount
        metadata:
          name: traefik
          namespace: {{ phase6_spoke_ingress_namespace }}
      - apiVersion: rbac.authorization.k8s.io/v1
        kind: ClusterRole
        metadata:
          name: fleet-{{ ocm_target_cluster }}-traefik
        rules:
          - apiGroups: [""]
            resources: [services, endpoints, secrets, nodes]
            verbs: [get, list, watch]
          - apiGroups: [networking.k8s.io]
            resources: [ingresses, ingressclasses]
            verbs: [get, list, watch]
          - apiGroups: [discovery.k8s.io]
            resources: [endpointslices]
            verbs: [get, list, watch]
      - apiVersion: rbac.authorization.k8s.io/v1
        kind: ClusterRoleBinding
        metadata:
          name: fleet-{{ ocm_target_cluster }}-traefik
        roleRef:
          apiGroup: rbac.authorization.k8s.io
          kind: ClusterRole
          name: fleet-{{ ocm_target_cluster }}-traefik
        subjects:
          - kind: ServiceAccount
            name: traefik
            namespace: {{ phase6_spoke_ingress_namespace }}
      - apiVersion: apps/v1
        kind: Deployment
        metadata:
          name: traefik
          namespace: {{ phase6_spoke_ingress_namespace }}
          annotations:
            fleet.umkim.com/acme-reconcile: "4"
        spec:
          replicas: 1
          selector:
            matchLabels:
              app: traefik
          template:
            metadata:
              labels:
                app: traefik
              annotations:
                fleet.umkim.com/acme-reconcile: "4"
            spec:
              serviceAccountName: traefik
              containers:
                - name: traefik
                  image: {{ phase6_traefik_image }}
                  args:
                    - --providers.kubernetesingress
                    - --providers.kubernetesingress.ingressclass=traefik
                    - --providers.kubernetesingress.ingressendpoint.publishedservice={{ phase6_spoke_ingress_namespace }}/traefik
                    - --entrypoints.web.address=:8000
                    - --entrypoints.websecure.address=:8443
                    - --entrypoints.web-hub.address=:8001
                    - --ping=true
                    - --ping.entrypoint=web
                    - --log.level=INFO
{% if phase6_spoke_acme and not phase6_spoke_acme_http_challenge %}
                    - --entrypoints.web.http.redirections.entryPoint.to=:443
                    - --entrypoints.web.http.redirections.entryPoint.scheme=https
                    - --entrypoints.web.http.redirections.entryPoint.permanent=true
{% endif %}
{% if phase6_traefik_file_provider %}
                    - --providers.file.directory=/etc/traefik/dynamic
                    - --providers.file.watch=true
{% endif %}
{% if phase6_spoke_acme %}
                    - --certificatesresolvers.letsencrypt.acme.email={{ fleet_edge_acme_email }}
                    - --certificatesresolvers.letsencrypt.acme.storage=/data/acme.json
{% if fleet_edge_acme_staging | default(false) | bool %}
                    - --certificatesresolvers.letsencrypt.acme.caserver=https://acme-staging-v02.api.letsencrypt.org/directory
{% endif %}
{% if phase6_spoke_acme_http_challenge %}
                    - --certificatesresolvers.letsencrypt.acme.httpchallenge=true
                    - --certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web
{% else %}
                    - --certificatesresolvers.letsencrypt.acme.tlschallenge=true
{% endif %}
{% if fleet_edge_acme_preflight_enabled | default(true) | bool %}
                    - --certificatesresolvers.letsencrypt-staging.acme.email={{ fleet_edge_acme_email }}
                    - --certificatesresolvers.letsencrypt-staging.acme.storage=/data/acme-staging.json
                    - --certificatesresolvers.letsencrypt-staging.acme.caserver=https://acme-staging-v02.api.letsencrypt.org/directory
                    - --certificatesresolvers.letsencrypt-staging.acme.httpchallenge=true
                    - --certificatesresolvers.letsencrypt-staging.acme.httpchallenge.entrypoint=web
{% endif %}
{% endif %}
                  ports:
                    - name: web
                      containerPort: 8000
                    - name: websecure
                      containerPort: 8443
                    - name: web-hub
                      containerPort: 8001
                  readinessProbe:
                    tcpSocket:
                      port: 8000
                    initialDelaySeconds: 3
                    periodSeconds: 10
                  volumeMounts:
{% if phase6_spoke_acme %}
                    - name: acme
                      mountPath: /data
{% endif %}
{% if phase6_traefik_file_provider %}
                    - name: traefik-dynamic
                      mountPath: /etc/traefik/dynamic
                      readOnly: true
{% endif %}
              volumes:
{% if phase6_spoke_acme %}
                - name: acme
                  persistentVolumeClaim:
                    claimName: traefik-acme
{% endif %}
{% if phase6_traefik_file_provider %}
                - name: traefik-dynamic
                  projected:
                    sources:
{% if fleet_ingress_auth_enabled | default(false) | bool %}
                      - configMap:
                          name: fleet-ingress-auth-traefik
                          optional: true
{% endif %}
{% endif %}
      - apiVersion: v1
        kind: Service
        metadata:
          name: traefik
          namespace: {{ phase6_spoke_ingress_namespace }}
        spec:
          type: NodePort
          selector:
            app: traefik
          ports:
            - name: web
              port: 80
              targetPort: 8000
              nodePort: {{ spoke_ingress_http_nodeport }}
            - name: websecure
              port: 443
              targetPort: 8443
              nodePort: {{ spoke_ingress_https_nodeport }}
            - name: web-hub
              port: 8080
              targetPort: 8001
              nodePort: {{ spoke_ingress_hub_http_nodeport | default(30081) }}
{% if phase6_deploy_whoami_demo | bool %}
{% set fleet_whoami_apps = [] %}
{% set homelab_whoami_apps = [] %}
{% for app in fleet_edge_apps | default([]) %}
{% if ocm_target_cluster in app.clusters | default([]) %}
{% if fleet_homelab_edge_domain | default('homelab.mgmt.umkim.com') in app.host or 'apps.umkim.com' in app.host %}
{% set _ = homelab_whoami_apps.append(app) %}
{% elif fleet_edge_domain in app.host and fleet_homelab_edge_domain | default('homelab.' ~ fleet_edge_domain) not in app.host %}
{% set _ = fleet_whoami_apps.append(app) %}
{% endif %}
{% endif %}
{% endfor %}
      - apiVersion: apps/v1
        kind: Deployment
        metadata:
          name: whoami
          namespace: {{ phase6_spoke_ingress_namespace }}
        spec:
          replicas: 1
          selector:
            matchLabels:
              app: whoami
          template:
            metadata:
              labels:
                app: whoami
            spec:
              containers:
                - name: whoami
                  image: {{ phase6_whoami_image }}
                  ports:
                    - containerPort: 80
      - apiVersion: v1
        kind: Service
        metadata:
          name: whoami
          namespace: {{ phase6_spoke_ingress_namespace }}
        spec:
          selector:
            app: whoami
          ports:
            - port: 80
              targetPort: 80
      - apiVersion: networking.k8s.io/v1
        kind: Ingress
        metadata:
          name: whoami
          namespace: {{ phase6_spoke_ingress_namespace }}
        spec:
          ingressClassName: traefik
          rules:
            - host: whoami.{{ ocm_target_cluster }}.{{ domain }}
              http:
                paths:
                  - path: /
                    pathType: Prefix
                    backend:
                      service:
                        name: whoami
                        port:
                          number: 80
{% if fleet_whoami_apps | length > 0 %}
      - apiVersion: networking.k8s.io/v1
        kind: Ingress
        metadata:
          name: whoami-fleet
          namespace: {{ phase6_spoke_ingress_namespace }}
        spec:
          ingressClassName: traefik
          rules:
{% for app in fleet_whoami_apps %}
            - host: "{{ app.host }}"
              http:
                paths:
                  - path: {{ app.path_prefix | default('/') }}
                    pathType: Prefix
                    backend:
                      service:
                        name: whoami
                        port:
                          number: 80
{% endfor %}
{% endif %}
{% if fleet_edge_direct_ingress | default(false) | bool and homelab_whoami_apps | length > 0 %}
      - apiVersion: networking.k8s.io/v1
        kind: Ingress
        metadata:
          name: whoami-homelab
          namespace: {{ phase6_spoke_ingress_namespace }}
          annotations:
            traefik.ingress.kubernetes.io/router.entrypoints: web
        spec:
          ingressClassName: traefik
          rules:
{% for app in homelab_whoami_apps %}
            - host: "{{ app.host }}"
              http:
                paths:
                  - path: {{ app.path_prefix | default('/') }}
                    pathType: Prefix
                    backend:
                      service:
                        name: whoami
                        port:
                          number: 80
{% endfor %}
{% if fleet_edge_acme_enabled | default(false) | bool %}
      - apiVersion: networking.k8s.io/v1
        kind: Ingress
        metadata:
          name: whoami-homelab-tls
          namespace: {{ phase6_spoke_ingress_namespace }}
          annotations:
            traefik.ingress.kubernetes.io/router.entrypoints: websecure
            traefik.ingress.kubernetes.io/router.tls: "true"
            traefik.ingress.kubernetes.io/router.tls.certresolver: letsencrypt
        spec:
          ingressClassName: traefik
          tls:
{% for app in homelab_whoami_apps %}
            - hosts:
                - "{{ app.host }}"
{% endfor %}
          rules:
{% for app in homelab_whoami_apps %}
            - host: "{{ app.host }}"
              http:
                paths:
                  - path: {{ app.path_prefix | default('/') }}
                    pathType: Prefix
                    backend:
                      service:
                        name: whoami
                        port:
                          number: 80
{% endfor %}
{% endif %}
{% endif %}
{% endif %}
