# Managed by Ansible role: wireguard (hub server)
# Endpoint: {{ wireguard_endpoint_host }}:{{ wireguard_endpoint_port }} -> {{ ansible_host }}

[Interface]
Address = {{ wireguard_address }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_private_key }}
PostUp = /usr/local/bin/umkim-restore-hub-wg-peers.sh --operators-only

{% for peer in wireguard_peers %}
[Peer]  # {{ peer }}
PublicKey = {{ hostvars[peer]['wireguard_public_key'] }}
AllowedIPs = {{ hostvars[peer]['wireguard_address'] | ansible.utils.ipaddr('address') }}/32
{% endfor %}
{% for peer in wireguard_dynamic_peers | default([]) %}
[Peer]  # {{ peer.name }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips }}
{% endfor %}
