#!/usr/bin/env bash
# UMKIM fleet site bootstrap — idempotent. Site: {{ fleet_site_name }}
# Generated by UMKIM; do not edit WireGuard keys by hand.
set -euo pipefail

FLEET_SITE_NAME="{{ fleet_site_name }}"
FLEET_SITE_ENROLL_TOKEN="{{ fleet_site_enrollment_token }}"
FLEET_HUB_WG_IP="{{ fleet_site_hub_wireguard_ip }}"
ENROLL_URL="{{ fleet_site_enrollment_base_url }}/site-enrollments/${FLEET_SITE_NAME}"
WG_IFACE="wg-umkim"
WG_CONF="/etc/wireguard/${WG_IFACE}.conf"
WG_CONF_NEW="/etc/wireguard/${WG_IFACE}.conf.umkim-new"
WG_UNIT="wg-quick@${WG_IFACE}"

log() { echo "[fleet-site-bootstrap] $*"; }

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    log "Run as root: sudo $0"
    exit 1
  fi
}

assert_rocky9() {
  if [[ ! -f /etc/os-release ]]; then
    log "ERROR: /etc/os-release missing"
    exit 1
  fi
  # shellcheck source=/dev/null
  source /etc/os-release
  if [[ "${ID}" != "rocky" ]] || [[ "${VERSION_ID%%.*}" != "{{ fleet_site_rocky_major | default('9') }}" ]]; then
    log "ERROR: Rocky Linux {{ fleet_site_rocky_major | default('9') }} required (found ${ID:-?} ${VERSION_ID:-?})"
    exit 1
  fi
}

install_packages() {
  if command -v dnf >/dev/null 2>&1; then
    dnf install -y wireguard-tools curl iputils 2>/dev/null || dnf install -y wireguard-tools curl iputils
  elif command -v yum >/dev/null 2>&1; then
    yum install -y wireguard-tools curl iputils
  else
    log "ERROR: dnf/yum not found"
    exit 1
  fi
}

write_wg_config() {
  install -d -m 0700 /etc/wireguard
  cat >"${WG_CONF_NEW}" <<'WGEOF'
{{ fleet_site_wg_config_block }}
WGEOF
  if [[ -f "${WG_CONF}" ]] && cmp -s "${WG_CONF}" "${WG_CONF_NEW}"; then
    log "WireGuard config unchanged"
    rm -f "${WG_CONF_NEW}"
  else
    mv "${WG_CONF_NEW}" "${WG_CONF}"
    chmod 600 "${WG_CONF}"
    log "WireGuard config written to ${WG_CONF}"
  fi
}

install_wg_dns_ready() {
  install -d -m 0755 /usr/local/libexec /etc/systemd/system/wg-quick@.service.d
  cat >/usr/local/libexec/umkim-wg-wait-dns.sh <<'DNSEOF'
#!/usr/bin/env bash
set -euo pipefail
IFACE="${1:-}"
[[ -n "${IFACE}" ]] || exit 2
CONF="/etc/wireguard/${IFACE}.conf"
[[ -f "${CONF}" ]] || exit 1
mapfile -t HOSTS < <(
  awk -F= '
    tolower($1) ~ /^[[:space:]]*endpoint[[:space:]]*$/ {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
      split($2, a, ":")
      h = a[1]
      if (h ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) next
      if (h ~ /^\[/) next
      if (length(h) > 0) print h
    }
  ' "${CONF}" | sort -u
)
[[ ${#HOSTS[@]} -eq 0 ]] && exit 0
TIMEOUT_SEC="${UMKIM_WG_DNS_WAIT_SEC:-120}"
deadline=$((SECONDS + TIMEOUT_SEC))
echo "umkim-wg-wait-dns: waiting up to ${TIMEOUT_SEC}s for: ${HOSTS[*]}"
while (( SECONDS < deadline )); do
  all_ok=1
  for h in "${HOSTS[@]}"; do
    getent hosts "${h}" >/dev/null 2>&1 || { all_ok=0; break; }
  done
  (( all_ok == 1 )) && { echo "umkim-wg-wait-dns: DNS ready"; exit 0; }
  sleep 2
done
echo "umkim-wg-wait-dns: timed out resolving ${HOSTS[*]}" >&2
exit 1
DNSEOF
  chmod 0755 /usr/local/libexec/umkim-wg-wait-dns.sh
  cat >/etc/systemd/system/wg-quick@.service.d/umkim-dns-ready.conf <<'DROPEOF'
[Unit]
After=network-online.target nss-lookup.target NetworkManager-wait-online.service systemd-resolved.service
Wants=network-online.target
Wants=NetworkManager-wait-online.service

[Service]
ExecStartPre=/usr/local/libexec/umkim-wg-wait-dns.sh %i
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=300
StartLimitBurst=30
DROPEOF
  systemctl daemon-reload 2>/dev/null || true
}

start_wg() {
  install_wg_dns_ready
  systemctl daemon-reload 2>/dev/null || true
  systemctl enable "${WG_UNIT}" 2>/dev/null || true
  if systemctl is-active --quiet "${WG_UNIT}" 2>/dev/null; then
    systemctl restart "${WG_UNIT}" || { wg-quick down "${WG_IFACE}" 2>/dev/null || true; wg-quick up "${WG_IFACE}"; systemctl enable "${WG_UNIT}"; }
  elif wg show "${WG_IFACE}" >/dev/null 2>&1; then
    wg-quick down "${WG_IFACE}" 2>/dev/null || true
    wg-quick up "${WG_IFACE}"
    systemctl enable "${WG_UNIT}"
  else
    systemctl start "${WG_UNIT}" 2>/dev/null || wg-quick up "${WG_IFACE}"
    systemctl enable "${WG_UNIT}"
  fi
}

wait_for_hub() {
  local i
  for i in $(seq 1 60); do
    if ping -c1 -W2 "${FLEET_HUB_WG_IP}" >/dev/null 2>&1; then
      log "Hub overlay ${FLEET_HUB_WG_IP} reachable"
      return 0
    fi
    sleep 2
  done
  log "ERROR: cannot ping hub at ${FLEET_HUB_WG_IP}"
  exit 1
}

post_enrollment() {
  local hostname rocky
  hostname="$(hostname -s 2>/dev/null || hostname)"
  rocky="$(. /etc/os-release && echo "${VERSION_ID}")"
  local body
  body=$(printf '{"hostname":"%s","rockyVersion":"%s","wgPublicKey":"%s","scriptVersion":"1"}' \
    "${hostname}" "${rocky}" "{{ fleet_site_wg_public_key }}")
  local code
  code=$(curl -sf -o /tmp/fleet-site-enroll.json -w '%{http_code}' \
    -X POST "${ENROLL_URL}" \
    -H "Authorization: Bearer ${FLEET_SITE_ENROLL_TOKEN}" \
    -H "Content-Type: application/json" \
    -d "${body}" || echo "000")
  if [[ "${code}" == "200" ]] || [[ "${code}" == "409" ]]; then
    log "Enrollment acknowledged (HTTP ${code})"
    cat /tmp/fleet-site-enroll.json 2>/dev/null || true
    return 0
  fi
  log "ERROR: enrollment POST failed (HTTP ${code})"
  cat /tmp/fleet-site-enroll.json 2>/dev/null || true
  exit 1
}

main() {
  require_root
  assert_rocky9
  install_packages
  write_wg_config
  start_wg
  wait_for_hub
  post_enrollment
  log "Bootstrap complete for site ${FLEET_SITE_NAME}. Continue in Fleet Console (Validate → Provision)."
}

main "$@"
