package dcm.fleet.site.vm.{{ fleet_site_ocm_cluster | regex_replace('[^a-zA-Z0-9]', '_') }}

cluster_matches if {
  some uv in input.spec.user_values
  uv.path == "routing.cluster"
  uv.value == "{{ fleet_site_ocm_cluster }}"
}

cluster_matches if {
  input.spec.routing.cluster == "{{ fleet_site_ocm_cluster }}"
}

main := {
  "rejected": false,
  "selected_provider": "{{ fleet_site_kubevirt_provider }}"
} if {
  input.spec.service_type == "vm"
  cluster_matches
}
