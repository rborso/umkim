# UMKIM fleet overlay — split tunnel (only {{ wireguard_operator_client_allowed_ips }} via VPN).
# Generated by Ansible for {{ item.name }} — do not commit private keys.
#
# Linux:   sudo wg-quick up {{ wireguard_operator_clients_config_filename }}
# Windows: Import in WireGuard app (split tunnel: allowed IPs = {{ wireguard_operator_client_allowed_ips }})

[Interface]
Address = {{ item.address }}
PrivateKey = {{ item.private_key }}
# No DNS — only fleet overlay traffic uses this tunnel.

[Peer]
PublicKey = {{ wireguard_hub_public_key }}
Endpoint = {{ wireguard_endpoint_host }}:{{ wireguard_endpoint_port }}
AllowedIPs = {{ wireguard_operator_client_allowed_ips }}
PersistentKeepalive = {{ wireguard_persistent_keepalive }}
