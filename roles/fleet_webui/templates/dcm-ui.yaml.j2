# DCM API explorer (Swagger UI + nginx API proxy for same-origin requests)
apiVersion: v1
kind: ConfigMap
metadata:
  name: dcm-openapi
  namespace: {{ fleet_webui_namespace }}
data:
  openapi.yaml: |
{{ lookup('ansible.builtin.file', role_path + '/files/dcm-openapi.yaml') | indent(4, first=True) }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dcm-ui-nginx
  namespace: {{ fleet_webui_namespace }}
data:
  default.conf: |
{{ lookup('ansible.builtin.template', role_path + '/templates/dcm-ui-nginx.conf.j2') | indent(4, first=True) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dcm-ui
  namespace: {{ fleet_webui_namespace }}
  labels:
    app: dcm-ui
spec:
  replicas: 1
  selector:
    matchLabels:
      app: dcm-ui
  template:
    metadata:
      labels:
        app: dcm-ui
    spec:
      containers:
        - name: swagger-ui
          image: {{ dcm_ui_image }}
          ports:
            - containerPort: 8081
          env:
            - name: SWAGGER_JSON
              value: /openapi/openapi.yaml
            - name: BASE_URL
              value: /
            - name: PORT
              value: "8081"
          volumeMounts:
            - name: openapi
              mountPath: /openapi
              readOnly: true
        - name: nginx
          image: {{ ocm_console_image }}
          ports:
            - containerPort: 8080
          volumeMounts:
            - name: nginx-conf
              mountPath: /etc/nginx/conf.d/default.conf
              subPath: default.conf
              readOnly: true
          readinessProbe:
            httpGet:
              path: /
              port: 8080
            initialDelaySeconds: 3
            periodSeconds: 10
      volumes:
        - name: openapi
          configMap:
            name: dcm-openapi
        - name: nginx-conf
          configMap:
            name: dcm-ui-nginx
---
apiVersion: v1
kind: Service
metadata:
  name: dcm-ui
  namespace: {{ fleet_webui_namespace }}
spec:
  type: NodePort
  selector:
    app: dcm-ui
  ports:
    - name: http
      port: 80
      targetPort: 8080
      nodePort: {{ dcm_ui_nodeport }}
