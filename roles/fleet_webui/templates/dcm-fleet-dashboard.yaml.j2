# DCM fleet operations dashboard (PatternFly SPA or legacy static HTML)
{% if dcm_fleet_use_patternfly | default(true) | bool %}
{% set fleet_nginx_tpl = role_path + '/templates/dcm-fleet-nginx-spa.conf.j2' %}
{% else %}
{% set fleet_nginx_tpl = role_path + '/templates/dcm-fleet-nginx.conf.j2' %}
{% endif %}
{% set fleet_nginx_checksum = lookup('ansible.builtin.template', fleet_nginx_tpl) | hash('sha256') %}
apiVersion: v1
kind: ConfigMap
metadata:
  name: dcm-fleet-dashboard
  namespace: {{ fleet_webui_namespace }}
data:
{% if not (dcm_fleet_use_patternfly | default(true) | bool) %}
  dcm-fleet-dashboard.html: |
{{ lookup('ansible.builtin.file', role_path + '/files/dcm-fleet-dashboard.html') | indent(4, first=True) }}
{% endif %}
  default.conf: |
{% if dcm_fleet_use_patternfly | default(true) | bool %}
{{ lookup('ansible.builtin.template', role_path + '/templates/dcm-fleet-nginx-spa.conf.j2') | indent(4, first=True) }}
{% else %}
{{ lookup('ansible.builtin.template', role_path + '/templates/dcm-fleet-nginx.conf.j2') | indent(4, first=True) }}
{% endif %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dcm-fleet-dashboard
  namespace: {{ fleet_webui_namespace }}
  labels:
    app: dcm-fleet-dashboard
spec:
  replicas: 1
  selector:
    matchLabels:
      app: dcm-fleet-dashboard
  template:
    metadata:
      labels:
        app: dcm-fleet-dashboard
      annotations:
        checksum/nginx-config: "{{ fleet_nginx_checksum }}"
    spec:
      containers:
        - name: nginx
          image: {{ dcm_fleet_image }}
          imagePullPolicy: {{ dcm_fleet_image_pull_policy | default('IfNotPresent') }}
          ports:
            - containerPort: 8080
          volumeMounts:
{% if not (dcm_fleet_use_patternfly | default(true) | bool) %}
            - name: content
              mountPath: /usr/share/nginx/html/dcm-fleet-dashboard.html
              subPath: dcm-fleet-dashboard.html
{% endif %}
            - name: content
              mountPath: /etc/nginx/conf.d/default.conf
              subPath: default.conf
          readinessProbe:
            httpGet:
              path: {{ '/fleet/' if (dcm_fleet_use_patternfly | default(true) | bool) else '/' }}
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10
          resources:
            requests:
              cpu: 10m
              memory: {{ '64Mi' if (dcm_fleet_use_patternfly | default(true) | bool) else '32Mi' }}
            limits:
              memory: {{ '256Mi' if (dcm_fleet_use_patternfly | default(true) | bool) else '128Mi' }}
      volumes:
        - name: content
          configMap:
            name: dcm-fleet-dashboard
---
apiVersion: v1
kind: Service
metadata:
  name: dcm-fleet-dashboard
  namespace: {{ fleet_webui_namespace }}
spec:
  type: NodePort
  selector:
    app: dcm-fleet-dashboard
  ports:
    - name: http
      port: 80
      targetPort: 8080
      nodePort: {{ dcm_fleet_dashboard_nodeport }}
