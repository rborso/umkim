# OCM read-only fleet console (nginx + kubectl proxy)
apiVersion: v1
kind: Namespace
metadata:
  name: {{ fleet_console_namespace }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ocm-console
  namespace: {{ fleet_console_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: fleet-ocm-console-reader
rules:
  - apiGroups: ["cluster.open-cluster-management.io"]
    resources: ["managedclusters", "managedclustersets", "placements", "placementdecisions"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["work.open-cluster-management.io"]
    resources: ["manifestworks", "appliedmanifestworks"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["addon.open-cluster-management.io"]
    resources: ["managedclusteraddons", "clustermanagementaddons"]
    verbs: ["get", "list", "watch"]
  - apiGroups: [""]
    resources: ["namespaces"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: fleet-ocm-console-reader
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: fleet-ocm-console-reader
subjects:
  - kind: ServiceAccount
    name: ocm-console
    namespace: {{ fleet_console_namespace }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ocm-console-nginx
  namespace: {{ fleet_console_namespace }}
data:
  default.conf: |
{{ lookup('ansible.builtin.file', role_path + '/files/nginx-ocm.conf') | indent(4, first=True) }}
  ocm-console.html: |
{{ lookup('ansible.builtin.file', role_path + '/files/ocm-console.html') | indent(4, first=True) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ocm-console
  namespace: {{ fleet_console_namespace }}
  labels:
    app: ocm-console
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ocm-console
  template:
    metadata:
      labels:
        app: ocm-console
    spec:
      serviceAccountName: ocm-console
      containers:
        - name: kubectl-proxy
          image: {{ ocm_kubectl_image }}
          command:
            - /bin/bash
            - -ec
            - |
              kubectl proxy --address=127.0.0.1 --port=8001 --accept-hosts='.*' --accept-paths='.*'
          resources:
            requests:
              cpu: 10m
              memory: 64Mi
        - name: nginx
          image: {{ ocm_console_image }}
          ports:
            - containerPort: 8080
          volumeMounts:
            - name: www
              mountPath: /usr/share/nginx/html/ocm-console.html
              subPath: ocm-console.html
            - name: nginx-conf
              mountPath: /etc/nginx/conf.d/default.conf
              subPath: default.conf
          readinessProbe:
            httpGet:
              path: /
              port: 8080
            initialDelaySeconds: 3
            periodSeconds: 10
      volumes:
        - name: www
          configMap:
            name: ocm-console-nginx
        - name: nginx-conf
          configMap:
            name: ocm-console-nginx
---
apiVersion: v1
kind: Service
metadata:
  name: ocm-console
  namespace: {{ fleet_console_namespace }}
spec:
  type: NodePort
  selector:
    app: ocm-console
  ports:
    - name: http
      port: 80
      targetPort: 8080
      nodePort: {{ ocm_console_nodeport }}
