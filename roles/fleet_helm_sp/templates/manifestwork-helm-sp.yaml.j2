# OCM ManifestWork — fleet-helm-release-sp on spoke {{ ocm_target_cluster }}
apiVersion: work.open-cluster-management.io/v1
kind: ManifestWork
metadata:
  name: {{ phase5_helm_sp_manifestwork_name }}
  namespace: {{ ocm_target_cluster }}
  labels:
    fleet.umkim.com/phase: "5"
    fleet.umkim.com/component: helm-release-sp
spec:
  workload:
    manifests:
      - apiVersion: v1
        kind: Namespace
        metadata:
          name: {{ phase5_helm_sp_worker_namespace }}
{% if fleet_helm_sp_harbor_pull_secret | default(false) | bool %}
      - apiVersion: v1
        kind: Secret
        metadata:
          name: {{ fleet_helm_sp_harbor_pull_secret_name }}
          namespace: {{ phase5_helm_sp_worker_namespace }}
        type: kubernetes.io/dockerconfigjson
        data:
          .dockerconfigjson: >-
            {{ {
              "auths": {
                (harbor_fleet_registry): {
                  "username": "admin",
                  "password": harbor_admin_password,
                  "auth": ("admin:" ~ harbor_admin_password) | b64encode
                }
              }
            } | to_json | b64encode }}
{% endif %}
      - apiVersion: v1
        kind: ServiceAccount
        metadata:
          name: helm-release-sp
          namespace: {{ phase5_helm_sp_worker_namespace }}
      - apiVersion: rbac.authorization.k8s.io/v1
        kind: ClusterRoleBinding
        metadata:
          name: fleet-{{ ocm_target_cluster }}-helm-sp
        roleRef:
          apiGroup: rbac.authorization.k8s.io
          kind: ClusterRole
          name: cluster-admin
        subjects:
          - kind: ServiceAccount
            name: helm-release-sp
            namespace: {{ phase5_helm_sp_worker_namespace }}
      - apiVersion: v1
        kind: Service
        metadata:
          name: fleet-helm-release-sp
          namespace: {{ phase5_helm_sp_worker_namespace }}
        spec:
          type: NodePort
          selector:
            app: fleet-helm-release-sp
          ports:
            - name: http
              port: 8080
              targetPort: 8080
              nodePort: {{ dcm_helm_sp_nodeport }}
      - apiVersion: apps/v1
        kind: Deployment
        metadata:
          name: fleet-helm-release-sp
          namespace: {{ phase5_helm_sp_worker_namespace }}
        spec:
          replicas: 1
          selector:
            matchLabels:
              app: fleet-helm-release-sp
          template:
            metadata:
              labels:
                app: fleet-helm-release-sp
            spec:
              serviceAccountName: helm-release-sp
{% if fleet_helm_sp_harbor_pull_secret | default(false) | bool %}
              imagePullSecrets:
                - name: {{ fleet_helm_sp_harbor_pull_secret_name }}
{% endif %}
              containers:
                - name: provider
                  image: "{{ dcm_helm_sp_image | default(phase5_helm_sp_image) }}"
                  imagePullPolicy: Always
                  ports:
                    - containerPort: 8080
                  env:
                    - name: SP_NAME
                      value: "{{ dcm_helm_sp_name }}"
                    - name: SP_ENDPOINT
                      value: "http://{{ dcm_helm_sp_endpoint_host }}:{{ dcm_helm_sp_nodeport }}/api/v1alpha1/releases"
                    - name: SP_DISPLAY_NAME
                      value: "Helm releases on {{ ocm_target_cluster }}"
                    - name: SP_REGION
                      value: fleet
                    - name: SP_ZONE
                      value: "{{ ocm_target_cluster }}"
                    - name: SP_SITE
                      value: "{{ hostvars[ocm_target_cluster].fleet_site | default('') }}"
                    - name: DCM_REGISTRATION_URL
                      value: "{{ hostvars[ocm_target_cluster].phase5_registration_url | default(phase5_registration_url) }}"
                    - name: SP_SERVER_ADDRESS
                      value: ":8080"
                    - name: HARBOR_CHART_PREFIX
                      value: "{{ harbor_charts_oci_prefix | default('oci://' ~ harbor_host ~ ':' ~ harbor_nodeport_https ~ '/charts') }}"
                    - name: HELM_CHART_OCI_PREFIXES
                      value: "{{ helm_chart_oci_prefixes | default(harbor_charts_oci_prefix | default('oci://' ~ harbor_host ~ ':' ~ harbor_nodeport_https ~ '/charts') ~ ',oci://registry-1.docker.io,oci://docker.io,oci://quay.io,oci://ghcr.io') }}"
                    - name: HELM_REGISTRY_HOST
                      value: "{{ harbor_host }}:{{ harbor_nodeport_https }}"
                    - name: HELM_REGISTRY_USER
                      value: admin
                    - name: HELM_REGISTRY_PASSWORD
                      value: "{{ harbor_admin_password }}"
                    - name: HELM_TIMEOUT_SEC
                      value: "600"
                    - name: HELM_INSECURE_SKIP_TLS_VERIFY
                      value: "{{ fleet_helm_sp_insecure_skip_tls | default(true) | string | lower }}"
                    - name: HELM_CREATE_ASYNC
                      value: "true"
                    - name: SP_NATS_URL
                      value: "{{ hostvars[ocm_target_cluster].phase5_nats_url | default(phase5_nats_url) }}"
                    - name: SP_NATS_SUBJECT
                      value: "dcm.helm"
                  readinessProbe:
                    httpGet:
                      path: /api/v1alpha1/releases/health
                      port: 8080
                    initialDelaySeconds: 15
                    periodSeconds: 10
