apiVersion: v1
kind: Secret
metadata:
  name: {{ fleet_ingress_auth_secrets_name | default('fleet-ingress-auth-secrets') }}
  namespace: {{ fleet_site_controller_namespace }}
  labels:
    app.kubernetes.io/name: fleet-ingress-auth
type: Opaque
stringData:
  bootstrapPassword: {{ fleet_auth_lldap_admin_password | to_json }}
  lldapJwtSecret: {{ fleet_auth_lldap_jwt_secret | to_json }}
  sessionSecret: {{ fleet_ingress_auth_session_secret | default(fleet_auth_lldap_jwt_secret) | to_json }}
  storageEncryptionKey: {{ fleet_ingress_auth_storage_encryption_key | default(fleet_auth_lldap_jwt_secret) | to_json }}
  resetJwtSecret: {{ fleet_ingress_auth_reset_jwt_secret | default(fleet_auth_lldap_jwt_secret) | to_json }}
