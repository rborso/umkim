# Extra vars for console-driven Ansible jobs (fleet-ansible-runner).
harbor_admin_password: {{ harbor_admin_password | to_json }}
harbor_charts_oci_prefix: {{ (harbor_charts_oci_prefix | default('oci://' ~ harbor_host ~ ':' ~ harbor_nodeport_https ~ '/charts')) | to_json }}
helm_chart_oci_prefixes: {{ (helm_chart_oci_prefixes | default((harbor_charts_oci_prefix | default('oci://' ~ harbor_host ~ ':' ~ harbor_nodeport_https ~ '/charts')) ~ ',oci://registry-1.docker.io,oci://docker.io,oci://quay.io,oci://ghcr.io')) | to_json }}
fleet_site_controller_namespace: {{ fleet_site_controller_namespace | default('fleet-console') | to_json }}
fleet_velero_version: {{ fleet_velero_version | default('v1.15.2') | to_json }}
