{% set _cc = (fleet_ingress_auth_cluster_configs | default({})).get(ocm_target_cluster, {}) %}
{% set _portal = _cc.portal_host | default(fleet_ingress_auth_portal_host) %}
{% set _cookie = _cc.cookie_domain | default(_portal | regex_replace('^auth\\.', '')) %}
{% set _access = _cc.access_domains | default(fia_spoke_access_domains | default(fleet_ingress_auth_access_domains | default([]))) %}
{% set _access_rules = _cc.access_rules | default([]) %}
{% set _expose_lldap = _cc.expose_lldap_webui | default(fleet_ingress_auth_lldap_expose_webui | default(false)) | bool %}
{% set _spoke_tls = _cc.spoke_tls | default(true) | bool %}
{% set _secrets = _cc.secrets_dir | default('/secrets/ingress-auth/clusters/' + ocm_target_cluster) %}
{% set _lldap_host = _cc.lldap_webui_host | default(fleet_ingress_auth_lldap_webui_host | default('')) %}
{% set _directory = _cc.directory | default('local') %}
{% set _hub_dir = (_directory == 'hub') %}
{# Prefer per-cluster Secret files (console enable / Job mounts); fall back to hub defaults. #}
{% set _lldap_pass = lookup('ansible.builtin.file', _secrets + '/lldapAdminPassword', errors='ignore') | default(fleet_ingress_auth_lldap_admin_password, true) | trim %}
{% set _lldap_jwt = lookup('ansible.builtin.file', _secrets + '/lldapJwtSecret', errors='ignore') | default(fleet_ingress_auth_lldap_jwt_secret, true) | trim %}
{% set _session = lookup('ansible.builtin.file', _secrets + '/sessionSecret', errors='ignore') | default(fleet_ingress_auth_session_secret, true) | trim %}
{% set _storage = lookup('ansible.builtin.file', _secrets + '/storageEncryptionKey', errors='ignore') | default(fleet_ingress_auth_storage_encryption_key, true) | trim %}
{% set _reset = lookup('ansible.builtin.file', _secrets + '/resetJwtSecret', errors='ignore') | default(fleet_ingress_auth_reset_jwt_secret, true) | trim %}
{% set _oidc_clients = _cc.oidc_clients | default([]) %}
{# Groups the cluster's routes declare. The chart reconciles them into this
   cluster's own directory so an operator never has to create a tenant group by
   hand before an invite can use it. #}
{% set _managed = namespace(groups=[]) %}
{% for r in _access_rules %}
{% for g in r.groups %}
{% if g not in _managed.groups %}{% set _managed.groups = _managed.groups + [g] %}{% endif %}
{% endfor %}
{% endfor %}
{% set _oidc_hmac = lookup('ansible.builtin.file', _secrets + '/oidcHmacSecret', errors='ignore') | default('') | trim %}
{% set _oidc_key = lookup('ansible.builtin.file', _secrets + '/oidcIssuerPrivateKey', errors='ignore') | default('') | trim %}
{% set _oidc_raw = lookup('ansible.builtin.file', _secrets + '/oidcClientSecrets', errors='ignore') %}
{% set _oidc_secrets = (_oidc_raw | from_json) if (_oidc_raw is defined and _oidc_raw) else {} %}
namespace: {{ fleet_ingress_auth_namespace }}

enabled: true
createNamespace: true

persistence:
  storageClass: {{ fleet_ingress_auth_persistence_storage_class | default('local-path') | quote }}

lldap:
  deploy: {{ (not _hub_dir) | bool | lower }}
  externalUrl: {{ (fleet_ingress_auth_hub_directory_url | default('ldap://10.10.0.1:30389')) if _hub_dir else '' | quote }}
  image: {{ fleet_ingress_auth_lldap_image }}
  ldapPort: {{ fleet_ingress_auth_lldap_ldap_port }}
  httpPort: {{ fleet_ingress_auth_lldap_http_port | default(17170) }}
  baseDN: {{ fleet_ingress_auth_lldap_base_dn }}
  jwtSecret: {{ _lldap_jwt | quote }}
  adminPassword: {{ _lldap_pass | quote }}
  exposeWebUI: {{ _expose_lldap }}
  webUIHost: {{ (_lldap_host if _expose_lldap else '') | quote }}
  # Groups the cluster's routes declare (route.requireAuthGroups). Only a
  # cluster with its own directory owns them; a hub-directory cluster uses the
  # hub's groups, which the hub reconciles.
  managedGroups:
{% if not _hub_dir %}
{% for g in _managed.groups %}
    - {{ g | quote }}
{% endfor %}
{% endif %}
  managedGroupsSchedule: {{ fleet_ingress_auth_lldap_managed_groups_schedule | default('*/10 * * * *') | quote }}
  # Tenant every own-directory LLDAP gets, so an invitation or a tenant
  # add-user has a group to target out of the box; empty disables it.
  defaultTenant: {{ fleet_ingress_auth_lldap_default_tenant | default('default-tenant') | quote }}
  bindAccount:
    # Only clusters that run their own LLDAP create the shared bind account.
    enabled: {{ (not _hub_dir) | bool | lower }}
    username: {{ fleet_ingress_auth_lldap_bind_username | default('svc-bind') | quote }}
    group: {{ fleet_ingress_auth_lldap_bind_group | default('lldap_strict_readonly') | quote }}
    password: {{ (_lldap_jwt | string) | hash('sha256') | quote }}
    secretName: lldap-service-accounts

authelia:
  image: {{ fleet_ingress_auth_authelia_image }}
  port: {{ fleet_ingress_auth_authelia_port }}
  sessionSecret: {{ _session | quote }}
  storageEncryptionKey: {{ _storage | quote }}
  resetPasswordJWTSecret: {{ _reset | quote }}
  portalHost: {{ _portal }}
  publicURL: "https://{{ _portal }}"
  cookieDomain: {{ _cookie }}
  accessDomains:
{% for d in _access %}
    - {{ d | quote }}
{% endfor %}
{% if _access_rules | length > 0 %}
  accessRules:
{% for r in _access_rules %}
    - domain: {{ r.domain | quote }}
      groups:
{% for g in r.groups %}
        - {{ g | quote }}
{% endfor %}
{% endfor %}
{% endif %}
{% if _oidc_clients | length > 0 %}
  # OIDC provider (Authelia over LLDAP) for OIDC-only apps.
  oidc:
    enabled: true
    hmacSecret: {{ _oidc_hmac | quote }}
    issuerPrivateKey: |
{{ _oidc_key | indent(6, true) }}
    clients:
{% for c in _oidc_clients %}
      - clientId: {{ c.client_id | quote }}
        clientName: {{ c.client_name | default(c.client_id) | quote }}
        clientSecret: {{ _oidc_secrets.get(c.client_id, '') | quote }}
        authorizationPolicy: one_factor
        redirectUris:
{% for u in c.redirect_uris | default([]) %}
          - {{ u | quote }}
{% endfor %}
        scopes:
{% for s in c.scopes | default(['openid', 'profile', 'email']) %}
          - {{ s | quote }}
{% endfor %}
        requirePkce: {{ (c.require_pkce | default(true)) | bool | lower }}
{% endfor %}
{% endif %}
{% if _hub_dir %}
  # Bind to the shared hub directory with the read-only account (LDAP over WireGuard).
  ldapUser: {{ ('uid=' ~ (fleet_ingress_auth_lldap_bind_username | default('svc-bind')) ~ ',ou=people,' ~ fleet_ingress_auth_lldap_base_dn) | quote }}
  ldapPassword: {{ fleet_ingress_auth_hub_directory_bind_password | default('') | quote }}
{% endif %}

signup:
  # Cluster-local sign-up page. The form posts to the hub, which redeems the
  # invite against whichever directory the invite targets: the cluster's own
  # LLDAP (directory: local) or the shared hub directory (directory: hub).
  # Enabled whenever the hub redeem URL is configured.
  enabled: {{ ((fleet_ingress_auth_hub_redeem_url | default('')) | length > 0) | bool | lower }}
  image: {{ fleet_ingress_auth_signup_image | default('nginx:1.27-alpine') | quote }}
  hubRedeemURL: {{ fleet_ingress_auth_hub_redeem_url | default('') | quote }}

traefik:
  deploySpokeMiddleware: true
  middlewareName: {{ fleet_ingress_auth_traefik_middleware_name }}
  middlewareNamespace: {{ fleet_ingress_auth_spoke_traefik_namespace }}
  portalEntrypoint: {{ 'websecure' if _spoke_tls else 'web' }}
  portalTLS: {{ _spoke_tls | bool | lower }}

registry:
  prefix: ""
