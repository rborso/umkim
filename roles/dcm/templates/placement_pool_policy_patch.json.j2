{% set rego_code -%}
package dcm.fleet.pool.{{ item.pool }}.{{ item.service_type }}

main := {
  "rejected": false
} if {
  input.spec.service_type == "{{ item.service_type }}"
}
{%- endset %}
{
  "display_name": {{ item.display_name | to_json }},
  "description": {{ (
      'Place ' ~ item.service_type ~ ' workloads with fleet.org on ' ~ item.pool ~ ' pool clusters'
    ) | to_json }},
  "enabled": true,
  "priority": {{ item.priority | int }},
  "label_selector": {
    "fleet.placement/pool": {{ item.pool | to_json }}
  },
  "cluster_requirements": {
    "matchLabels": {
      "fleet.pool": {{ item.pool | to_json }}
    },
    "matchExpressions": []
  },
  "placement": {{ (
      {"cluster_count": 1, "strategy": "least_utilized", "site_diversity": false}
      if item.pool == 'shared'
      else {"cluster_count": 1, "strategy": "single", "site_diversity": false}
    ) | to_json }},
  "rego_code": {{ rego_code | to_json }}
}
