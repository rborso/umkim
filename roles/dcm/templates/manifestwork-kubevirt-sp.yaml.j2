# OCM ManifestWork — kubevirt-service-provider on spoke {{ ocm_target_cluster }}
apiVersion: work.open-cluster-management.io/v1
kind: ManifestWork
metadata:
  name: {{ phase5_kubevirt_sp_manifestwork_name | default('phase5-kubevirt-sp') }}
  namespace: {{ ocm_target_cluster }}
  labels:
    fleet.umkim.com/phase: "5"
    fleet.umkim.com/component: kubevirt-sp
spec:
  workload:
    manifests:
      - apiVersion: v1
        kind: Namespace
        metadata:
          name: {{ phase5_worker_namespace }}
      - apiVersion: v1
        kind: ServiceAccount
        metadata:
          name: kubevirt-service-provider
          namespace: {{ phase5_worker_namespace }}
      - apiVersion: rbac.authorization.k8s.io/v1
        kind: ClusterRoleBinding
        metadata:
          name: fleet-{{ ocm_target_cluster }}-kubevirt-sp
        roleRef:
          apiGroup: rbac.authorization.k8s.io
          kind: ClusterRole
          name: cluster-admin
        subjects:
          - kind: ServiceAccount
            name: kubevirt-service-provider
            namespace: {{ phase5_worker_namespace }}
      - apiVersion: v1
        kind: Service
        metadata:
          name: kubevirt-service-provider
          namespace: {{ phase5_worker_namespace }}
        spec:
          type: NodePort
          selector:
            app: kubevirt-service-provider
          ports:
            - name: http
              port: 8080
              targetPort: 8080
              nodePort: {{ dcm_kubevirt_sp_nodeport }}
      - apiVersion: apps/v1
        kind: Deployment
        metadata:
          name: kubevirt-service-provider
          namespace: {{ phase5_worker_namespace }}
        spec:
          replicas: 1
          selector:
            matchLabels:
              app: kubevirt-service-provider
          template:
            metadata:
              labels:
                app: kubevirt-service-provider
            spec:
              serviceAccountName: kubevirt-service-provider
              containers:
                - name: provider
                  image: >-
                    {{ hostvars[ocm_target_cluster].dcm_kubevirt_sp_image
                       | default(dcm_kubevirt_sp_image | default(
                           harbor_fleet_image_prefix ~ '/kubevirt-service-provider:'
                           ~ (harbor_fleet_image_tag | default(umkim_version)))) }}
                  imagePullPolicy: IfNotPresent
                  ports:
                    - containerPort: 8080
                  env:
                    - name: PROVIDER_NAME
                      value: "{{ dcm_kubevirt_sp_name }}"
                    - name: PROVIDER_DISPLAY_NAME
                      value: "KubeVirt VMs on {{ ocm_target_cluster }}"
                    - name: PROVIDER_ENDPOINT
                      value: "http://{{ dcm_kubevirt_sp_endpoint_host }}:{{ dcm_kubevirt_sp_nodeport }}/api/v1alpha1/vms"
                    - name: PROVIDER_LISTEN_ADDRESS
                      value: "0.0.0.0:8080"
                    - name: PROVIDER_REGION
                      value: fleet
                    - name: PROVIDER_ZONE
                      value: "{{ ocm_target_cluster }}"
                    - name: PROVIDER_SITE
                      value: "{{ hostvars[ocm_target_cluster].fleet_site | default('') }}"
                    - name: SERVICE_MANAGER_ENDPOINT
                      value: "{{ hostvars[ocm_target_cluster].phase5_registration_url | default(phase5_registration_url) }}"
                    - name: NATS_URL
                      value: "{{ hostvars[ocm_target_cluster].phase5_nats_url | default(phase5_nats_url) }}"
                  readinessProbe:
                    httpGet:
                      path: /api/v1alpha1/vms/health
                      port: 8080
                    initialDelaySeconds: 15
                    periodSeconds: 10
