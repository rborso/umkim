[
  {
    "path": "metadata.name",
    "display_name": "Helm release name",
    "editable": true,
    "validation_schema": {
      "type": "string",
      "x-ui-tier": "required",
      "x-ui-widget": "dns-label",
      "x-required": true
    }
  },
  {
    "path": "chart.repository",
    "display_name": "Chart OCI repository",
    "editable": false,
    "default": "{{ dcm_helm_chart_oci }}",
    "validation_schema": { "type": "string" }
  },
  {
    "path": "chart.name",
    "display_name": "Chart name",
    "editable": false,
    "default": "{{ helm_catalog_chart_name }}",
    "validation_schema": { "type": "string" }
  },
  {
    "path": "chart.version",
    "display_name": "Chart version",
    "editable": false,
    "default": "{{ helm_catalog_chart_version | default('0.1.0') }}",
    "validation_schema": { "type": "string" }
  },
  {
    "path": "release.namespace",
    "display_name": "Target namespace",
    "editable": true,
    "default": "default",
    "validation_schema": { "type": "string", "x-ui-tier": "common" }
  },
  {
    "path": "values.replicaCount",
    "display_name": "Replicas per cluster",
    "editable": true,
    "default": 1,
    "validation_schema": {
      "type": "integer",
      "minimum": 1,
      "x-ui-tier": "common",
      "x-ui-widget": "number"
    }
  },
  {
    "path": "values",
    "display_name": "Helm values (full YAML)",
    "editable": true,
    "validation_schema": {
      "type": "string",
      "format": "yaml",
      "x-ui-tier": "advanced",
      "x-ui-widget": "yaml"
    }
  },
  {
    "path": "install.wait",
    "display_name": "Wait for readiness",
    "editable": true,
    "default": true,
    "validation_schema": { "type": "boolean", "x-ui-tier": "advanced", "x-ui-widget": "boolean" }
  },
  {
    "path": "install.timeout",
    "display_name": "Install timeout (seconds)",
    "editable": true,
    "default": 600,
    "validation_schema": {
      "type": "integer",
      "minimum": 60,
      "x-ui-tier": "advanced",
      "x-ui-widget": "number"
    }
  },
  {
    "path": "install.atomic",
    "display_name": "Atomic install",
    "editable": true,
    "default": true,
    "validation_schema": { "type": "boolean", "x-ui-tier": "advanced", "x-ui-widget": "boolean" }
  },
  {
    "path": "routing.mode",
    "display_name": "Routing mode",
    "editable": true,
    "default": "hub",
    "validation_schema": {
      "type": "string",
      "enum": ["hub", "site", "none"],
      "x-ui-tier": "common"
    }
  },
  {
    "path": "routing.require_auth",
    "display_name": "Require Authelia (FleetAppRoute only)",
    "editable": true,
    "default": false,
    "validation_schema": {
      "type": "boolean",
      "x-ui-widget": "boolean",
      "x-ui-tier": "common",
      "x-ui-depends-on": { "path": "routing.mode", "in": ["hub", "site"] }
    }
  },
  {
    "path": "routing.hub_host",
    "display_name": "Hub hostname (custom FQDN)",
    "editable": true,
    "default": "",
    "description": "Override hub URL. Leave empty for {release}.{hub-zone} from the fleet edge registry.",
    "validation_schema": {
      "type": "string",
      "x-ui-widget": "hostname",
      "x-ui-tier": "common",
      "x-ui-depends-on": { "path": "routing.mode", "in": ["hub"] }
    }
  },
  {
    "path": "routing.site_host",
    "display_name": "Site hostname (optional FQDN)",
    "editable": true,
    "default": "",
    "validation_schema": { "type": "string", "x-ui-tier": "common" }
  },
  {
    "path": "routing.cluster",
    "display_name": "Target cluster (OCM name)",
    "editable": true,
    "default": "",
    "description": "Optional — pin to a cluster; otherwise policy selects from fleet.site + capabilities",
    "validation_schema": { "type": "string", "x-ui-tier": "advanced" }
  }
]
