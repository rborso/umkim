{# Dedicated ACME TLS-ALPN solver — fleet-edge-controller scales to 1 and moves WAN externalIPs here during issuance. #}
{% set gateway_acme = fleet_edge_acme_enabled | default(false) | bool %}
{% set gateway_ha = (dcm_gateway_replicas | default(1) | int) > 1 %}
{% set solver_enabled = dcm_gateway_acme_solver_enabled | default(gateway_acme) | bool %}
{% if gateway_acme and gateway_ha and solver_enabled %}
apiVersion: v1
kind: ConfigMap
metadata:
  name: dcm-traefik-acme-routes
  namespace: {{ phase5_dcm_namespace }}
  labels:
    app: dcm-gateway-acme
data:
  fleet-routes.yml: |
    http:
      middlewares:
        fleet-edge-forward-headers:
          headers:
            customRequestHeaders:
              X-Forwarded-Proto: http
---
apiVersion: v1
kind: Service
metadata:
  name: gateway-acme
  namespace: {{ phase5_dcm_namespace }}
  labels:
    app: dcm-gateway-acme
spec:
  type: NodePort
  selector:
    app: dcm-gateway-acme
  ports:
    - name: http
      port: 80
      targetPort: 80
      nodePort: {{ phase5_gateway_acme_http_nodeport | default(30918) }}
    - name: https
      port: 443
      targetPort: 443
      nodePort: {{ phase5_gateway_acme_https_nodeport | default(30919) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gateway-acme
  namespace: {{ phase5_dcm_namespace }}
  labels:
    app: dcm-gateway-acme
spec:
  replicas: 0
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: dcm-gateway-acme
  template:
    metadata:
      labels:
        app: dcm-gateway-acme
      annotations:
        checksum/dcm-traefik-static: "{{ dcm_traefik_static_checksum }}"
        checksum/dcm-traefik-acme-routes: "{{ dcm_traefik_acme_routes_checksum | default('init') }}"
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      containers:
        - name: traefik
          image: {{ phase5_traefik_image }}
          args:
            - --configFile=/etc/traefik/traefik.yml
          ports:
            - name: http
              containerPort: 80
            - name: https
              containerPort: 443
          readinessProbe:
            httpGet:
              path: /ping
              port: http
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /ping
              port: http
            periodSeconds: 10
          volumeMounts:
            - name: static
              mountPath: /etc/traefik/traefik.yml
              subPath: traefik.yml
              readOnly: true
            - name: acme-routes
              mountPath: /etc/traefik/dynamic
              readOnly: true
            - name: acme
              mountPath: /var/traefik
      volumes:
        - name: static
          configMap:
            name: dcm-traefik-static
        - name: acme-routes
          projected:
            sources:
              - configMap:
                  name: dcm-traefik-acme-routes
                  items:
                    - key: fleet-routes.yml
                      path: fleet-routes.yml
        - name: acme
          hostPath:
            path: {{ dcm_gateway_acme_host_path }}
            type: DirectoryOrCreate
---
{% endif %}
