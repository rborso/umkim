# Strategic-merge patch: checksum annotation change triggers a new gateway ReplicaSet.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gateway
  namespace: {{ phase5_dcm_namespace }}
spec:
  template:
    metadata:
      annotations:
        checksum/dcm-traefik-static: "{{ dcm_traefik_static_checksum }}"
        checksum/dcm-traefik-dynamic: "{{ dcm_traefik_dynamic_checksum }}"
