[
  {
    "path": "metadata.name",
    "display_name": "Helm release name",
    "editable": true,
    "validation_schema": {
      "type": "string",
      "x-ui-tier": "required",
      "x-ui-widget": "dns-label",
      "x-required": true
    }
  },
  {
    "path": "chart.repository",
    "display_name": "Chart OCI repository",
    "editable": false,
    "default": "{{ dcm_helm_chart_oci }}",
    "validation_schema": { "type": "string" }
  },
  {
    "path": "chart.name",
    "display_name": "Chart name",
    "editable": false,
    "default": "llama-cpp-helm",
    "validation_schema": { "type": "string" }
  },
  {
    "path": "chart.version",
    "display_name": "Chart version",
    "editable": false,
    "default": "0.1.2",
    "validation_schema": { "type": "string" }
  },
  {
    "path": "release.namespace",
    "display_name": "Target namespace",
    "editable": true,
    "default": "llm",
    "validation_schema": { "type": "string", "x-ui-tier": "common" }
  },
  {
    "path": "workload.gpu.count",
    "display_name": "GPU instances (per cluster)",
    "editable": true,
    "default": 1,
    "description": "Replica count on the placed GPU cluster. Maps to values.replicaCount.",
    "validation_schema": {
      "type": "integer",
      "minimum": 1,
      "x-ui-tier": "common",
      "x-ui-widget": "number"
    }
  },
  {
    "path": "values.model",
    "display_name": "OpenAI model name",
    "editable": true,
    "default": "Qwen2.5-0.5B-Instruct",
    "description": "Returned by /v1/models; LiteLLM model_name and hub /llm/ requests must use this id.",
    "validation_schema": { "type": "string", "x-ui-tier": "required" }
  },
  {
    "path": "values.hfRepo",
    "display_name": "Hugging Face GGUF repo",
    "editable": true,
    "default": "Qwen/Qwen2.5-0.5B-Instruct-GGUF",
    "description": "Example: Qwen/Qwen2.5-0.5B-Instruct-GGUF (paired with values.hfQuant, default Q4_K_M).",
    "validation_schema": { "type": "string", "x-ui-tier": "common" }
  },
  {
    "path": "values.hfQuant",
    "display_name": "GGUF quantization",
    "editable": true,
    "default": "Q4_K_M",
    "validation_schema": { "type": "string", "x-ui-tier": "advanced" }
  },
  {
    "path": "values.ctxSize",
    "display_name": "Context size (tokens)",
    "editable": true,
    "default": 2048,
    "description": "llama.cpp -c / --ctx-size passed to the server.",
    "validation_schema": {
      "type": "integer",
      "minimum": 512,
      "x-ui-tier": "common",
      "x-ui-widget": "number"
    }
  },
  {
    "path": "values.replicaCount",
    "display_name": "Replicas (advanced)",
    "editable": true,
    "default": 1,
    "validation_schema": {
      "type": "integer",
      "minimum": 1,
      "x-ui-tier": "advanced",
      "x-ui-widget": "number"
    }
  },
  {
    "path": "values",
    "display_name": "Helm values (full YAML)",
    "editable": true,
    "default": {{ dcm_llama_cpp_helm_values_default | to_json }},
    "validation_schema": {
      "type": "string",
      "format": "yaml",
      "x-ui-tier": "advanced",
      "x-ui-widget": "yaml"
    }
  },
  {
    "path": "routing.mode",
    "display_name": "Routing mode",
    "editable": true,
    "default": "none",
    "validation_schema": {
      "type": "string",
      "enum": ["none", "hub", "site"],
      "x-ui-tier": "common"
    }
  },
  {
    "path": "routing.cluster",
    "display_name": "Target cluster (optional)",
    "editable": true,
    "default": "",
    "validation_schema": { "type": "string", "x-ui-tier": "advanced" }
  }
]
