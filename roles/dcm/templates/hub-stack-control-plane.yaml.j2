apiVersion: v1
kind: Service
metadata:
  name: control-plane
  namespace: {{ phase5_dcm_namespace }}
spec:
  selector:
    app: control-plane
  ports:
    - name: http
      port: 8080
      targetPort: 8080
    - name: engine
      port: 8081
      targetPort: 8081
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: control-plane
  namespace: {{ phase5_dcm_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: control-plane
  template:
    metadata:
      labels:
        app: control-plane
    spec:
      serviceAccountName: control-plane
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      containers:
        - name: control-plane
          image: {{ phase5_control_plane_image }}
          imagePullPolicy: Always
          ports:
            - containerPort: 8080
            - containerPort: 8081
          env:
            - name: DB_TYPE
              value: pgsql
            - name: DB_HOST
              value: postgres
            - name: DB_PORT
              value: "5432"
            - name: DB_USER
              valueFrom:
                secretKeyRef:
                  name: dcm-postgres
                  key: POSTGRES_USER
            - name: DB_PASS
              valueFrom:
                secretKeyRef:
                  name: dcm-postgres
                  key: POSTGRES_PASSWORD
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: dcm-postgres
                  key: POSTGRES_PASSWORD
            - name: DB_NAME
              value: control-plane
            - name: BIND_ADDRESS
              value: ":8080"
            - name: ENGINE_BIND_ADDRESS
              value: ":8081"
            - name: LOG_LEVEL
              value: info
            - name: NATS_URL
              value: nats://nats:4222
            - name: ENABLE_CLUSTER_PLACEMENT
              value: "true"
            - name: HELM_SP_PROXY_URL
              value: "{{ dcm_helm_sp_proxy_url | default('', true) }}"
            - name: SP_PROVIDER_HTTP_TIMEOUT
              value: "{{ dcm_spm_provider_http_timeout | default('10m') }}"
            - name: WRITE_TIMEOUT
              value: "{{ dcm_control_plane_write_timeout | default('5m') }}"
            - name: READ_TIMEOUT
              value: "{{ dcm_control_plane_read_timeout | default('1m') }}"

