# Merge under fleet_sites: in inventory/group_vars/all/fleet_sites.yml
# Hub gateway — maps to live site "umkim" (management datacenter).
management:
  display_name: Management DC
  region: management
  exposure_mode: hub_gateway
  management_site: true
  edge_domain: apps.example.com
  edge_wildcard: "*.apps.example.com"
  external_endpoints:
    - id: hub-wan
      address: "203.0.113.10"   # RFC5737 — VPS public IP
      role: primary
      description: "VPS public IP — hub Traefik :80/:443"
  domains:
    - id: hub-zone
      zone: apps.example.com
      wildcard: "*.apps.example.com"
      tls_policy: acme_hub
  dns_target_note: "A/AAAA *.apps.example.com → 203.0.113.10 (hub-wan)"
  wan_egress:
    enabled: true
    expected_wan_ip: "203.0.113.10"
  wireguard_pool: null
